# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local ist gitignored — niemals echte Werte committen.

# Datenbank (D221/D262): Supabase/Postgres — EINE gemeinsame Online-DB.
# Supabase → Connect → Direct Connection string → "Transaction pooler" (Port 6543).
# Pflicht: ohne DATABASE_URL startet die App nicht (kein lokaler Fallback).
DATABASE_URL=postgresql://postgres.<ref>:<PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Notausgang, falls ein Pooler-Endpunkt TLS verweigert. Normalfall: leer lassen
# (dann erzwingt der Code TLS). Nur im Ausnahmefall auf "off" setzen.
# DATABASE_SSL=

# Text-Generierung & Bild-Auslese (Claude). Fehlt der Key: Mock/kein Vision.
ANTHROPIC_API_KEY=

# Review-Scraping. Fehlt der Key: Review-Insights nur als Mock.
APIFY_API_KEY=

# Signatur der Login-Sitzungen — lange Zufallszeichenfolge (40+ Zeichen).
AUTH_SECRET=

# ── Amazon SP-API (D263) ─────────────────────────────────────────────────────
# Sandbox und Produktion sind bei Amazon GETRENNTE App-Registrierungen mit
# eigenen LWA-Credentials. Umschalten über AMAZON_SP_API_ENV; Default ist
# "sandbox", damit ein vergessener Schalter nie echte Kundenlistings anfasst.
AMAZON_SP_API_ENV=sandbox
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_API_APPLICATION_ID=
# 32 Byte Zufall als base64 oder hex. Verschlüsselt die Refresh Tokens
# (AES-256-GCM). Geht dieser Schlüssel verloren, müssen ALLE Kunden neu
# autorisieren — also im Passwort-Manager sichern.
AMAZON_TOKEN_ENCRYPTION_KEY=
# Produktionsadresse des Tools. MUSS zeichengenau der in Amazon Developer
# Central registrierten OAuth Redirect URI entsprechen (dort:
# <APP_URL>/api/amazon/callback). Bewusst nicht VERCEL_URL — die wechselt bei
# jedem Deploy und der Callback bricht dann ab.
APP_URL=

# Nur setzen, falls die App je im Selling Partner Appstore veröffentlicht wird
# (dann entfällt version=beta an der Consent-URL). Draft-Status: leer lassen.
# AMAZON_SP_API_APP_PUBLISHED=
